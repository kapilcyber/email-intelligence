# Microsoft Graph (Azure AD app registration)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Default mailbox for backfill / webhook (e.g. user@yourdomain.com)
MAILBOX_EMAIL=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# App
ENVIRONMENT=development

# Phase 2 — Ollama (primary); OpenAI is fallback when Ollama is unavailable
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Phase 4 — Admin: comma-separated emails allowed to access admin APIs (optional; else check users.role=Admin)
# ADMIN_EMAILS=admin@example.com,other@example.com
ADMIN_EMAILS=

# Escalation detection (optional; empty = use built-in defaults)
# ESCALATION_KEYWORDS=urgent,escalation,asap,critical,immediate
# ESCALATION_RE_THRESHOLD=3
# ESCALATION_CC_SENIOR_MIN=2
# ESCALATION_THREAD_THRESHOLD=5
# SENIOR_AUTHORITY_EMAILS=exec@company.com,ceo@company.com
# SENIOR_AUTHORITY_DOMAINS=executive.company.com

# Lead notification: when a lead is detected, POST to this URL (Slack, Zapier, or your endpoint)
# SALES_LEAD_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SALES_NOTIFICATION_EMAILS=sales@company.com
# NOTIFY_SALES_ON_LEAD=true
SALES_LEAD_WEBHOOK_URL=
NOTIFY_SALES_ON_LEAD=true

# Daily summary (end-of-day report); run via Celery Beat at hour/minute below
# DAILY_SUMMARY_WEBHOOK_URL=https://hooks.slack.com/... or your endpoint
# DAILY_SUMMARY_HOUR_UTC=23
# DAILY_SUMMARY_MINUTE_UTC=0
DAILY_SUMMARY_WEBHOOK_URL=

# Trust / spam from known senders (sender_trust_score; override to Spam when below min)
# SENDER_TRUST_ENABLED=true
# SENDER_TRUST_MIN_SCORE=0.3
