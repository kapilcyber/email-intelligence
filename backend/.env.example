# Microsoft Graph (Azure AD app registration)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Dashboard calendar: preferred = delegated Calendars.Read on the **same app** used for NextAuth sign-in
# (users re-sign in). Optional fallback = Application permission Calendars.Read + admin consent — see /api/dashboard/calendar-events
# Default mailbox for backfill / webhook (e.g. user@yourdomain.com)
MAILBOX_EMAIL=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# TLS/network overrides (use when your company proxy/SSL intercept causes CERTIFICATE_VERIFY_FAILED)
# Keep HTTP_VERIFY_SSL=true in normal environments.
HTTP_VERIFY_SSL=true
# Optional custom CA bundle path for corporate root certs (preferred over disabling verification)
# HTTP_CA_BUNDLE=C:\path\to\corporate-ca.pem

# App
ENVIRONMENT=development

# Phase 2 — Ollama (only)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3
# Fail fast (seconds)
# OLLAMA_REQUEST_TIMEOUT_SECONDS=22
# OLLAMA_MAX_RETRIES=2
# OLLAMA_RETRY_DELAY_SECONDS=0.25

# Phase 4 — Admin: comma-separated emails allowed to access admin APIs (optional; else check users.role=Admin)
# ADMIN_EMAILS=admin@example.com,other@example.com
ADMIN_EMAILS=

# Escalation detection (optional; empty = use built-in defaults)
# ESCALATION_KEYWORDS=urgent,escalation,asap,critical,immediate
# ESCALATION_RE_THRESHOLD=3
# ESCALATION_CC_SENIOR_MIN=2
# ESCALATION_THREAD_THRESHOLD=5
# SENIOR_AUTHORITY_EMAILS=exec@company.com,ceo@company.com
# SENIOR_AUTHORITY_DOMAINS=executive.company.com

# Lead notification: when a lead is detected, POST to this URL (Slack, Zapier, or your endpoint)
# SALES_LEAD_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SALES_NOTIFICATION_EMAILS=sales@company.com
# NOTIFY_SALES_ON_LEAD=true
SALES_LEAD_WEBHOOK_URL=
NOTIFY_SALES_ON_LEAD=true

# Daily summary (end-of-day report); run via Celery Beat at hour/minute below
# DAILY_SUMMARY_WEBHOOK_URL=https://hooks.slack.com/... or your endpoint
# DAILY_SUMMARY_HOUR_UTC=23
# DAILY_SUMMARY_MINUTE_UTC=0
DAILY_SUMMARY_WEBHOOK_URL=

# Sync Outlook “Deleted Items” for each users.email (Celery Beat every 4h + POST /api/admin/sync-outlook-deleted)
# OUTLOOK_DELETED_SYNC_ENABLED=true
# OUTLOOK_DELETED_SYNC_DAYS=14

# Inbox messageRules (Outlook mailbox rules): Graph app permission MailboxSettings.Read + admin consent
# OUTLOOK_MESSAGE_RULES_SYNC_ENABLED=true
# OUTLOOK_MESSAGE_RULES_SYNC_ON_BACKFILL=true
# OUTLOOK_MESSAGE_RULES_SYNC_HOUR_UTC=5
# OUTLOOK_MESSAGE_RULES_SYNC_MINUTE_UTC=30

# Full-mailbox Graph sync every N minutes for users with an open session (user_login_events.is_logged_in).
# Requires Celery Beat running (celery -A app.workers.celery_app beat); the worker alone does not fire the timer.
# MAILBOX_AUTO_SYNC_LOGGED_IN_ENABLED=true
# MAILBOX_AUTO_SYNC_LOGGED_IN_INTERVAL_MINUTES=5
# MAILBOX_AUTO_SYNC_LOGGED_IN_DAYS=0
# One-shot full mailbox after Microsoft sign-in (POST /api/me + X-Login-Source: oauth from NextAuth)
# MAILBOX_SYNC_ON_OAUTH_LOGIN_ENABLED=true

# Trust / spam from known senders (sender_trust_score; override to Spam when below min)
# SENDER_TRUST_ENABLED=true
# SENDER_TRUST_MIN_SCORE=0.3
