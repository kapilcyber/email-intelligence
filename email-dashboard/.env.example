# Backend API (Phase 1)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: server-only URL for NextAuth sign-in sync (use internal hostname in Docker if browsers use a public URL)
# BACKEND_API_URL=http://backend:8000

# Microsoft sign-in (NextAuth) — same Azure AD app as backend; add redirect URI in Azure Portal:
# Redirect URI: http://localhost:3001/api/auth/callback/azure-ad
# For multi-user mailbox sync, grant application permission Mail.Read (admin consent) to the app.
# Dashboard calendar uses app-only Graph unless you add delegated Calendars.Read (requires admin consent in many tenants).
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-random-secret-at-least-32-chars
# Optional: if not set here, copy from backend .env (AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional: OIDC discovery + token exchange timeout in ms (default 60000; openid-client default 3500 is often too low on VPN)
# AZURE_OAUTH_HTTP_TIMEOUT_MS=60000
