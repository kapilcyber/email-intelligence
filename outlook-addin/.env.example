# Origin used in the Outlook manifest (no trailing slash).
# For VM deployment, use the same HTTPS origin that serves the dashboard.
ADDIN_ORIGIN=https://172.16.200.30

# Full URL of the existing Email Intelligence dashboard (no trailing slash).
# Must match NEXTAUTH_URL / how users open the app in the browser.
DASHBOARD_URL=https://172.16.200.30

# Outlook add-in taskpane entry route inside the dashboard app.
TASKPANE_URL=https://172.16.200.30/outlook
