# Origin where this add-in static site is hosted (no trailing slash).
# Local Docker nginx: http://localhost:3010
# Production: https://ei-addin.yourcompany.internal
ADDIN_ORIGIN=http://localhost:3010

# Full URL of the existing Email Intelligence (Next.js) dashboard (no trailing slash).
# Must match NEXTAUTH_URL / how users open the app in the browser.
DASHBOARD_URL=http://localhost:3001
