<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="MailApp">
  <Id>8f3c1b2a-6d4e-4f1a-9c7b-2e8d0a1f4b5c</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Email Intelligence</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Email Intelligence"/>
  <Description DefaultValue="Open the internal Email Intelligence dashboard from Outlook."/>
  <IconUrl DefaultValue="{{ADDIN_ORIGIN}}/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="{{ADDIN_ORIGIN}}/assets/icon-128.png"/>
  <SupportUrl DefaultValue="{{ADDIN_ORIGIN}}/"/>
  <AppDomains>
    <AppDomain>{{ADDIN_ORIGIN}}</AppDomain>
    <AppDomain>{{DASHBOARD_APP_DOMAIN}}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.8">
      <Set Name="Mailbox"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{ADDIN_ORIGIN}}/taskpane.html"/>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemCompose">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{ADDIN_ORIGIN}}/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.8">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadEI">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgReadOpenEI">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                    <SupportsPinning>true</SupportsPinning>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgComposeEI">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgComposeOpenEI">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                    <SupportsPinning>true</SupportsPinning>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="{{ADDIN_ORIGIN}}/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="{{ADDIN_ORIGIN}}/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="{{ADDIN_ORIGIN}}/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="{{ADDIN_ORIGIN}}/taskpane.html"/>
        <bt:Url id="Commands.Url" DefaultValue="{{ADDIN_ORIGIN}}/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Email Intelligence"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Dashboard"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open the Email Intelligence web dashboard in your browser."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
